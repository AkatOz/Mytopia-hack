MODE=local
TOOLS_MODE=local
TOKEN_MODE=local
PORT=8787
ADMIN_TOKEN=change-me
DEMO_PACE=2.0
LOCAL_ISSUER_SECRET=change-me-too
COGNITO_POOL_ID=
COGNITO_SCOPE=mytopia/tools
AWS_REGION=us-east-1
AWS_PROFILE=gateway
AWS_CONFIG_FILE=
AWS_SHARED_CREDENTIALS_FILE=
TABLE_AGENTS=mytopia_agents
TABLE_EVENTS=mytopia_events
TOOLS_FUNCTION=mytopia-tools
EVENTS_JSONL=gateway/events.local.jsonl
QUARANTINE_AFTER=3
QUARANTINE_WINDOW_S=60
# send_email may only write to these domains (comma-separated, exact, case-insensitive); a recipient in any other
# domain is refused (rule egress) and pulls the badge at once
EMAIL_DOMAINS=example.corp
# the launcher env file the Factory appends a minted agent's client id and secret to
AGENT_ENV=agent/.env
